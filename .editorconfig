# Editor defaults; C formatting itself is defined by .clang-format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Generated or vendor files keep their own layout.
[{firmware/vehicle-ecu/Drivers/**,firmware/vehicle-ecu/Middlewares/**,firmware/vehicle-ecu/ThirdParty/**,firmware/vehicle-ecu/*.ioc,firmware/display-unit/main/assets/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
